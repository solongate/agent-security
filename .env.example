# ============================================
# SolonGate — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
#
# There is one service: the system (apps/system, port 3002) — policies, the
# audit log, sign-in, alerts and webhooks. The CLI and the guard run on each
# developer's machine and talk to it. Nothing here reaches a service
# you have not configured below, and there are no defaults pointing at anybody
# else's infrastructure.

# ── Database (required) ─────────────────────────────────────────────────────
# PostgreSQL, or a local sqlite file. Those are the only two schemes it
# accepts; it refuses anything else at startup rather than at the first query.
#
# APPLY THE SCHEMA FIRST: tools/schema/postgres.sql or tools/schema/sqlite.sql.
# The API creates the handful of tables it owns outright on start, but the base
# schema is not one of them — start it against an empty database and it logs that
# the runtime tables are not ready and serves 500s. See README.md.
DATABASE_URL=postgres://solongate:solongate@127.0.0.1:5432/solongate?sslmode=disable
# DATABASE_URL=file:./data/local.db
#
# Pool size is PER REPLICA. Divide the database's max_connections by the replica
# count and leave headroom for whoever operates it.
# SG_DB_MAX_OPEN_CONNS=24
# SG_DB_MAX_IDLE_CONNS=6

# ── The system ──────────────────────────────────────────────────────────────
PORT=3002
# Browser origins allowed to call this API with credentials. The default is
# loopback only; anything else has to be named here.
ALLOWED_ORIGINS=http://127.0.0.1:3005,http://localhost:3005

# ── Sign-in: your identity provider (OIDC) ──────────────────────────────────
# This is how anybody signs in. The CLI runs the OAuth device grant against the
# provider named here — GET /api/v1/auth/config is how each machine learns where
# to send somebody, so nothing is configured per laptop — and the system
# verifies the ID token that provider issues.
#
# The client must allow the device authorization grant, and being PUBLIC (no
# secret) is correct for one that runs on a laptop and can hold none.
#
# Without SG_OIDC_ISSUER there is nobody to sign in against and the CLI says so.
# For local development use tools/local-db.mjs, which seeds a project and prints
# a credential.
#
# SG_OIDC_CLIENT_ID is the audience check — without it tokens are still verified
# (signature, issuer, expiry) but could have been minted for another application
# at the same provider.
# SG_OIDC_ISSUER=https://idp.example.com
# SG_OIDC_CLIENT_ID=
# Extra scopes beyond openid/profile/email, space or comma separated.
# SG_OIDC_SCOPES=

# ── Sign-in: Supabase (the alternative to OIDC) ─────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=

# ── Optional: repository connection (GitHub OAuth app) ──────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── The CLI (packages/proxy), set on each developer's machine ───────────────
# Where the CLI and the guard look for the system. Defaults to http://127.0.0.1:3002.
# SOLONGATE_API_URL=https://solongate.internal.example.com
# SOLONGATE_API_KEY=sg_live_...
