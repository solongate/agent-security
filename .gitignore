# Local SQLite dev database (runtime artifact; dir kept via apps/api/data/.gitkeep)
apps/api/data/*.db
apps/api/data/*.db-shm
apps/api/data/*.db-wal

# SolonGate
.env.local
.solongate/**
.claude/**
.gemini/**
.openclaw/**
fs/
packages/proxy/hooks/.solongate/

# Cross-compiled npm platform packages (built by scripts/build-go-binaries.mjs).
# ~45 MB per target x 6; the Go source is what is tracked.
packages/proxy/platforms/

# Go guard build output (the source is tracked, the binary is not)
packages/guard-go/solongate-guard
packages/guard-go/solongate-guard.exe
# A bare `go build` names its output after the module, which is `guard`.
packages/guard-go/guard
packages/guard-go/guard.exe
packages/guard-go/dist-platforms/

# The same, for the CLI module, whose name is `proxy`. This one WAS committed:
# 9.3 MB of x86-64 ELF that no Dockerfile, script or package.json ever named.
packages/proxy-go/proxy
packages/proxy-go/proxy.exe

# tools/dev-go.mjs builds each Go app to <app>/.dev-server before running it
# (dev-go.mjs:96). Also committed once, 11 MB, and rebuilt on every dev run.
apps/*/.dev-server
apps/*/.dev-server.exe

# Local database built by tools/local-db.mjs (schema is generated, never edited)
.local-db/


# Stray screenshots. One reached a commit through `git add -A`; this is so the
# next one cannot.
image.png
**/image.png
