{
  "name": "solongate",
  "version": "0.0.0",
  "private": true,
  "description": "A policy gate for AI coding agents: every tool call is decided on your machine, against rules you wrote.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/solongate/agent-security#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solongate/agent-security.git"
  },
  "bugs": {
    "url": "https://github.com/solongate/agent-security/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "node-llama-cpp",
      "@node-llama-cpp/win-x64",
      "@node-llama-cpp/linux-x64",
      "@node-llama-cpp/linux-arm64"
    ],
    "overrides": {
      "basic-ftp": ">=5.2.0",
      "fast-xml-parser": ">=5.3.5",
      "tar": ">=6.2.1",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "rollup": ">=4.59.0",
      "openclaw": ">=2026.2.23"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
