  "license": "Apache-2.0",
  "homepage": "https://github.com/solongate/agent-security#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solongate/agent-security.git",
    "directory": "packages/hooks"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@open-policy-agent/opa-wasm": "^1.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "bugs": {
    "url": "https://github.com/solongate/agent-security/issues"
  }
