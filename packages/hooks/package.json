{
  "name": "@solongate/hooks",
  "version": "0.0.6",
  "description": "The hook programs SolonGate installs into an agent's client, and the scripts that build what ships.",
  "type": "module",
  "files": [
    "*.mjs",
    "*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/bundle-hooks.mjs",
