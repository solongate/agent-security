{
  "name": "@solongate/proxy",
  "version": "0.91.27",
  "description": "AI tool security proxy: protect any AI tool server with customizable policies, path/command constraints, rate limiting, and audit logging. No code changes required.",
  "type": "module",
  "bin": {
    "solongate": "./dist/cli-launch.js",
    "solongate-proxy": "./dist/cli-launch.js",
    "proxy": "./dist/cli-launch.js",
    "solongate-audit": "./dist/audit/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "hooks/*.mjs",
    "hooks/*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && pnpm build:types && pnpm build:hooks",
    "build:types": "node scripts/build-types.mjs",
    "build:hooks": "node scripts/bundle-hooks.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo platforms",
    "test": "node test/run-all.mjs",
    "build:go": "node scripts/build-go-binaries.mjs",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "ai-tool-security",
    "ai-tool-proxy",
    "security",
    "proxy",
    "gateway",
    "firewall",
    "ai-security",
    "tool-security",
    "claude",
    "solongate",
    "path-traversal",
    "rate-limiting"
  ],
  "author": "SolonGate <hello@solongate.com>",
  "license": "MIT",
  "homepage": "https://github.com/codeyevsky/solongate-oss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeyevsky/solongate-oss.git",
    "directory": "packages/proxy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@solongate/guard-linux-x64": "0.91.27",
    "@solongate/guard-linux-arm64": "0.91.27",
    "@solongate/guard-darwin-x64": "0.91.27",
    "@solongate/guard-darwin-arm64": "0.91.27",
    "@solongate/guard-win32-x64": "0.91.27",
    "@solongate/guard-win32-arm64": "0.91.27"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@solongate/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "chalk": "^5.3.0",
    "esbuild": "^0.19.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "bugs": {
    "url": "https://github.com/codeyevsky/solongate-oss/issues"
  }
}
