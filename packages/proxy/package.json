{
  "name": "@solongate/proxy",
  "version": "0.0.6",
  "description": "A policy gate for AI coding agents: every tool call is decided on your machine, against rules you wrote.",
  "type": "module",
  "bin": {
    "solongate": "./dist/cli-launch.js",
    "solongate-audit": "./dist/audit/index.js"
  },
  "files": [
    "dist",
    "hooks/*.mjs",
    "hooks/*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && pnpm build:types && pnpm build:hooks",
    "build:types": "node scripts/build-types.mjs",
    "build:hooks": "node scripts/bundle-hooks.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo platforms",
    "test": "node test/run-all.mjs",
    "build:go": "node scripts/build-go-binaries.mjs"
  },
  "keywords": [
    "ai-tool-security",
    "security",
    "firewall",
    "ai-security",
    "tool-security",
    "claude",
    "solongate",
    "path-traversal",
    "rate-limiting"
  ],
  "author": "SolonGate <hello@solongate.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/solongate/solongate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solongate/solongate.git",
    "directory": "packages/proxy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@solongate/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/solongate/solongate/issues"
  }
}
